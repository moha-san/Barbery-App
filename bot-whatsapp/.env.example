# IA (Claude). Se saca en console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# Base de datos (Supabase > Project Settings > API)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp (Meta for Developers > tu app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta for Developers > tu app > App settings > Basic > App secret
WHATSAPP_APP_SECRET=
# Cualquier palabra larga inventada; la misma que pongas al configurar el webhook en Meta
WHATSAPP_VERIFY_TOKEN=
# Nombres de las plantillas aprobadas en Meta (ver README)
WHATSAPP_PLANTILLA_BARBERO=peticion_cita
WHATSAPP_PLANTILLA_CLIENTE=aviso_cita
WHATSAPP_PLANTILLA_VOLVER=volver_cita

# Contraseña del planificador de recordatorios (cualquier texto largo inventado)
CRON_SECRET=
